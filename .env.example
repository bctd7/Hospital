# Local development only. Replace every password before deploying anywhere.
APP_ENV=local
APP_PORT=8888

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hospital
MYSQL_USER=hospital
MYSQL_PASSWORD=hospital_dev
MYSQL_ROOT_PASSWORD=hospital_root_dev
MYSQL_DSN=hospital:hospital_dev@tcp(127.0.0.1:3306)/hospital?charset=utf8mb4&parseTime=true&loc=UTC

IDENTITY_MYSQL_USER=hospital_identity
IDENTITY_MYSQL_PASSWORD=hospital_identity_dev
IDENTITY_MYSQL_DSN=hospital_identity:hospital_identity_dev@tcp(127.0.0.1:3306)/hospital_identity?charset=utf8mb4&parseTime=true&loc=UTC
IDENTITY_ACCESS_PRIVATE_KEY_BASE64=
IDENTITY_ACCESS_PUBLIC_KEY_BASE64=
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
SMS_PROVIDER=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=hospital_redis_dev

# Host applications connect to localhost:9092. Containers use kafka:29092.
KAFKA_PORT=9092
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_INTERNAL_BROKERS=kafka:29092
