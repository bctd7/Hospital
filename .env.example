# Local development only. Replace every password before deploying anywhere.
APP_ENV=local
APP_PORT=8888

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hospital
MYSQL_USER=hospital
MYSQL_PASSWORD=hospital_dev
MYSQL_ROOT_PASSWORD=hospital_root_dev
MYSQL_DSN=hospital:hospital_dev@tcp(127.0.0.1:3306)/hospital?charset=utf8mb4&parseTime=true&loc=UTC

IDENTITY_MYSQL_USER=hospital_identity
IDENTITY_MYSQL_PASSWORD=hospital_identity_dev
IDENTITY_MYSQL_DSN=hospital_identity:hospital_identity_dev@tcp(127.0.0.1:3306)/hospital_identity?charset=utf8mb4&parseTime=true&loc=UTC
APPOINTMENT_MYSQL_USER=hospital_appointment
APPOINTMENT_MYSQL_PASSWORD=hospital_appointment_dev
APPOINTMENT_MYSQL_DSN=hospital_appointment:hospital_appointment_dev@tcp(127.0.0.1:3306)/hospital_appointment?charset=utf8mb4&parseTime=true&loc=UTC
IDENTITY_ACCESS_PRIVATE_KEY_BASE64=
IDENTITY_ACCESS_PUBLIC_KEY_BASE64=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_PNVS_ENABLED=false
SMS_PROVIDER=disabled
# Set only in an untracked local .env when SMS_PROVIDER=local.
LOCAL_SMS_CODE=
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=100001
ALIYUN_PNVS_SCHEME_NAME=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=hospital_redis_dev
WECHAT_MINIAPP_APP_ID=wx8ba66b98c93423fd
WECHAT_MINIAPP_APP_SECRET=
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
IDENTITY_PHONE_LOOKUP_KEY_BASE64=aG9zcGl0YWwtbG9jYWwtcGhvbmUtbG9va3VwLWtleS0zMmI=

# Host applications connect to localhost:9092. Containers use kafka:29092.
KAFKA_PORT=9092
IDENTITY_KAFKA_ENABLED=true
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_INTERNAL_BROKERS=kafka:29092
