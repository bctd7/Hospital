syntax = "v1"

import "identity-auth.api"
import "identity-account-management.api"
import "identity-organization.api"
import "appointment-catalog.api"
import "appointment-resources.api"
import "appointment-bookings.api"
import "guidance-rules.api"
import "guidance-configuration.api"
import "guidance-planning.api"
import "guidance-routing.api"

info (
	title:                       "Hospital App API"
	desc:                        "医院微信小程序后端 API"
	author:                      "Hospital"
	version:                     "v1"
	securityDefinitionsFromJson: `{"BearerAuth":{"type":"apiKey","name":"Authorization","in":"header","description":"Use: Bearer <access_token>"}}`
)

type HealthResponse {
	Status  string `json:"status"`
	Service string `json:"service"`
	Version string `json:"version"`
}

@server (
	prefix: /api/v1
	group:  system
)
service app-api {
	@handler health
	get /health returns (HealthResponse)
}
