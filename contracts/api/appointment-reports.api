syntax = "v1"

// 检查报告草稿、发布、更正、版本与患者只读查询。
type (
	SaveReportDraftAPIRequest {
		BookingID             string `path:"bookingId"`
		ObjectiveFindings     string `json:"objective_findings,optional"`
		Impression            string `json:"impression,optional"`
		Recommendation        string `json:"recommendation,optional"`
		Notes                 string `json:"notes,optional"`
		ExpectedReportVersion int64  `json:"expected_report_version"`
		OperationID           string `json:"operation_id"`
	}
	CompleteAndPublishReportAPIRequest {
		BookingID              string `path:"bookingId"`
		ObjectiveFindings      string `json:"objective_findings"`
		Impression             string `json:"impression"`
		Recommendation         string `json:"recommendation,optional"`
		Notes                  string `json:"notes,optional"`
		ExpectedBookingVersion int64  `json:"expected_booking_version"`
		ExpectedReportVersion  int64  `json:"expected_report_version"`
		OperationID            string `json:"operation_id"`
	}
	CorrectReportAPIRequest {
		ReportID              string `path:"reportId"`
		ObjectiveFindings     string `json:"objective_findings"`
		Impression            string `json:"impression"`
		Recommendation        string `json:"recommendation,optional"`
		Notes                 string `json:"notes,optional"`
		CorrectionReason      string `json:"correction_reason"`
		ExpectedReportVersion int64  `json:"expected_report_version"`
		OperationID           string `json:"operation_id"`
	}
	ReportPathRequest {
		ReportID string `path:"reportId"`
	}
	ListMyReportsAPIRequest {
		Page     int64 `form:"page,default=1"`
		PageSize int64 `form:"page_size,default=20"`
	}
	ListDepartmentReportsAPIRequest {
		DepartmentID string `form:"department_id"`
		Keyword      string `form:"keyword,optional"`
		Page         int64  `form:"page,default=1"`
		PageSize     int64  `form:"page_size,default=20"`
	}
	ReportVersionResponse {
		VersionID        string `json:"version_id"`
		VersionNo        int64  `json:"version_no"`
		VersionKind      string `json:"version_kind"`
		Status           string `json:"status"`
		ObjectiveFindings string `json:"objective_findings"`
		Impression        string `json:"impression"`
		Recommendation    string `json:"recommendation"`
		Notes             string `json:"notes"`
		CorrectionReason string `json:"correction_reason,omitempty"`
		AuthoredBy       string `json:"authored_by"`
		AuthoredByDisplayName string `json:"authored_by_display_name"`
		PublishedBy      string `json:"published_by,omitempty"`
		PublishedByDisplayName string `json:"published_by_display_name,omitempty"`
		PublishedAt      string `json:"published_at,omitempty"`
		CreatedAt        string `json:"created_at"`
		UpdatedAt        string `json:"updated_at"`
	}
	ExaminationReportResponse {
		ReportID               string                `json:"report_id"`
		BookingID              string                `json:"booking_id"`
		PatientAccountID       string                `json:"patient_account_id"`
		PatientDisplayName     string                `json:"patient_display_name"`
		PatientPhoneMasked     string                `json:"patient_phone_masked"`
		DepartmentID           string                `json:"department_id"`
		DepartmentName         string                `json:"department_name"`
		ItemID                 string                `json:"item_id"`
		ItemName               string                `json:"item_name"`
		RoomID                 string                `json:"room_id"`
		CampusID               string                `json:"campus_id"`
		CampusName             string                `json:"campus_name"`
		Building               string                `json:"building"`
		FloorNumber            int32                 `json:"floor_number"`
		RoomNumber             string                `json:"room_number"`
		RoomDisplayName        string                `json:"room_display_name"`
		Status                 string                `json:"status"`
		PerformedBy            string                `json:"performed_by,omitempty"`
		PerformedByDisplayName string                `json:"performed_by_display_name,omitempty"`
		ExaminationStartedAt   string                `json:"examination_started_at,omitempty"`
		ExaminationCompletedAt string                `json:"examination_completed_at,omitempty"`
		Version                int64                 `json:"version"`
		CurrentVersion         ReportVersionResponse `json:"current_version"`
		CreatedAt              string                `json:"created_at"`
		UpdatedAt              string                `json:"updated_at"`
	}
	ListReportVersionsAPIResponse {
		Versions []ReportVersionResponse `json:"versions"`
	}
	ListReportsAPIResponse {
		Reports  []ExaminationReportResponse `json:"reports"`
		Page     int64                       `json:"page"`
		PageSize int64                       `json:"page_size"`
		Total    int64                       `json:"total"`
	}
)

@server (
	prefix: /api/v1
	group: appointmentbookings
	middleware: AccessToken
	authType: BearerAuth
)
service app-api {
	@handler saveExaminationReportDraft
	put /admin/appointment/bookings/:bookingId/report/draft (SaveReportDraftAPIRequest) returns (ExaminationReportResponse)
	@handler completeAndPublishExaminationReport
	post /admin/appointment/bookings/:bookingId/report/complete-and-publish (CompleteAndPublishReportAPIRequest) returns (ExaminationReportResponse)
	@handler getExaminationReport
	get /admin/appointment/bookings/:bookingId/report (BookingPathRequest) returns (ExaminationReportResponse)
	@handler listExaminationReports
	get /admin/appointment/reports (ListDepartmentReportsAPIRequest) returns (ListReportsAPIResponse)
	@handler correctExaminationReport
	post /admin/appointment/reports/:reportId/corrections (CorrectReportAPIRequest) returns (ExaminationReportResponse)
	@handler listExaminationReportVersions
	get /admin/appointment/reports/:reportId/versions (ReportPathRequest) returns (ListReportVersionsAPIResponse)
	@handler listMyExaminationReports
	get /appointment/reports (ListMyReportsAPIRequest) returns (ListReportsAPIResponse)
	@handler getMyExaminationReport
	get /appointment/bookings/:bookingId/report (BookingPathRequest) returns (ExaminationReportResponse)
}
