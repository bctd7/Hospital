syntax = "v1"

type (
	GuidanceLocationPoint {
		Name            string  `json:"name"`
		Address         string  `json:"address,optional"`
		Latitude        float64 `json:"latitude"`
		Longitude       float64 `json:"longitude"`
		ProviderPlaceID string  `json:"provider_place_id,optional"`
	}

	GuidanceRoutePoint {
		Latitude  float64 `json:"latitude"`
		Longitude float64 `json:"longitude"`
	}

	SearchGuidancePlacesRequest {
		Keyword string `form:"keyword"`
		City    string `form:"city,optional"`
		Limit   int32  `form:"limit,default=10"`
	}

	SearchGuidancePlacesResponse {
		Places []GuidanceLocationPoint `json:"places"`
	}

	GuidanceRouteStepResponse {
		Instruction    string `json:"instruction"`
		RoadName       string `json:"road_name"`
		DistanceMeters int32  `json:"distance_meters"`
		DurationSeconds int32 `json:"duration_seconds"`
	}

	CalculateGuidanceRouteRequest {
		Origin      GuidanceLocationPoint `json:"origin"`
		Destination GuidanceLocationPoint `json:"destination"`
		Mode        string                `json:"mode,options=walking|transit|driving"`
	}

	GuidanceRouteResponse {
		Origin          GuidanceLocationPoint       `json:"origin"`
		Destination     GuidanceLocationPoint       `json:"destination"`
		DistanceMeters  int32                       `json:"distance_meters"`
		DurationSeconds int32                       `json:"duration_seconds"`
		Polyline        []GuidanceRoutePoint        `json:"polyline"`
		Steps           []GuidanceRouteStepResponse `json:"steps"`
		Provider        string                      `json:"provider"`
		Mode            string                      `json:"mode"`
	}
)

@server (
	prefix:     /api/v1
	group:      guidancerouting
	middleware: AccessToken
	authType:   BearerAuth
)
service app-api {
	@handler searchGuidancePlaces
	get /guidance/places/search (SearchGuidancePlacesRequest) returns (SearchGuidancePlacesResponse)

	@handler calculateGuidanceRoute
	post /guidance/routes (CalculateGuidanceRouteRequest) returns (GuidanceRouteResponse)
}
