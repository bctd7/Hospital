syntax = "v1"

type (
    AccountDisplayProfileResponse {
        Nickname          *string `json:"nickname,optional"`
        ManagementVersion int64   `json:"management_version"`
    }

    UpdateAccountDisplayProfileRequest {
        Nickname string `json:"nickname"`
    }

    DirectoryDoctorPathRequest {
        DepartmentID string `path:"departmentId"`
        Page         int64  `form:"page,default=1"`
        PageSize     int64  `form:"page_size,default=20"`
    }

    DoctorSummaryResponse {
        AccountID   string  `json:"account_id"`
        DisplayName string  `json:"display_name"`
        DepartmentID string `json:"department_id"`
        AvatarURL   *string `json:"avatar_url,optional"`
        Description *string `json:"description,optional"`
        Version     int64   `json:"version"`
    }

    ListDoctorsResponse {
        Items    []DoctorSummaryResponse `json:"items"`
        Page     int64                   `json:"page"`
        PageSize int64                   `json:"page_size"`
        Total    int64                   `json:"total"`
    }

    AdminAccountSummaryResponse {
        AccountID         string  `json:"account_id"`
        Nickname          *string `json:"nickname,optional"`
        DisplayName       *string `json:"display_name,optional"`
        AvatarURL         *string `json:"avatar_url,optional"`
        MaskedPhone       *string `json:"masked_phone,optional"`
        AccountStatus     string  `json:"account_status"`
        IdentityType      string  `json:"identity_type"`
        DepartmentID      *string `json:"department_id,optional"`
        DepartmentName    *string `json:"department_name,optional"`
        ManagementVersion int64   `json:"management_version"`
    }

    AdminAccountDetailResponse {
        AccountID               string   `json:"account_id"`
        Nickname                *string  `json:"nickname,optional"`
        DisplayName             *string  `json:"display_name,optional"`
        AvatarURL               *string  `json:"avatar_url,optional"`
        MaskedPhone             *string  `json:"masked_phone,optional"`
        AccountStatus           string   `json:"account_status"`
        IdentityType            string   `json:"identity_type"`
        DepartmentID            *string  `json:"department_id,optional"`
        DepartmentName          *string  `json:"department_name,optional"`
        ManagementVersion       int64    `json:"management_version"`
        PhoneVerificationStatus *string  `json:"phone_verification_status,optional"`
        StaffNo                 *string  `json:"staff_no,optional"`
        Description             *string  `json:"description,optional"`
        Roles                   []string `json:"roles"`
        AuthorizationVersion    int64    `json:"authorization_version"`
        AvailableActions        []string `json:"available_actions"`
        CreatedAt               string   `json:"created_at"`
        UpdatedAt               string   `json:"updated_at"`
        StaffStatus             *string  `json:"staff_status,optional"`
    }

    ListAdminAccountsRequest {
        Page         int64  `form:"page,default=1"`
        PageSize     int64  `form:"page_size,default=20"`
        Nickname     string `form:"nickname,optional"`
        IdentityType string `form:"identity_type,optional"`
        Status       string `form:"status,optional"`
        DepartmentID string `form:"department_id,optional"`
    }

    ListAdminAccountsResponse {
        Items    []AdminAccountSummaryResponse `json:"items"`
        Page     int64                         `json:"page"`
        PageSize int64                         `json:"page_size"`
        Total    int64                         `json:"total"`
    }

    AdminAccountPathRequest {
        AccountID string `path:"accountId"`
    }

    AdminSearchAccountByPhoneRequest {
        Phone string `json:"phone"`
    }

    AdminSearchAccountByPhoneResponse {
        Identity AdminAccountSummaryResponse `json:"identity"`
        Phone    PhoneBindingResponse         `json:"phone"`
    }

    PromoteDoctorRequest {
        AccountID        string  `path:"accountId"`
        DepartmentID     string  `json:"department_id"`
        DisplayName      string  `json:"display_name"`
        StaffNo          *string `json:"staff_no,optional"`
        AvatarURL        *string `json:"avatar_url,optional"`
        Description      *string `json:"description,optional"`
        ManagementVersion int64  `json:"management_version"`
        OfflineVerified  bool    `json:"offline_verified"`
        OperationID      string  `json:"operation_id"`
    }

    UpdateDoctorRequest {
        AccountID         string  `path:"accountId"`
        DisplayName       *string `json:"display_name,optional"`
        StaffNo           *string `json:"staff_no,optional"`
        AvatarURL         *string `json:"avatar_url,optional"`
        Description       *string `json:"description,optional"`
        ManagementVersion int64   `json:"management_version"`
        OperationID       string  `json:"operation_id"`
    }

    ChangeDoctorDepartmentRequest {
        AccountID         string `path:"accountId"`
        DepartmentID      string `json:"department_id"`
        ManagementVersion int64  `json:"management_version"`
        OperationID       string `json:"operation_id"`
    }

    AccountMutationRequest {
        AccountID         string `path:"accountId"`
        ManagementVersion int64  `json:"management_version"`
        OperationID       string `json:"operation_id"`
    }
)

@server (
    prefix: /api/v1
    group: identityprofile
    middleware: AccessToken
    authType: BearerAuth
)
service app-api {
    @handler getAccountDisplayProfile
    get /auth/me/display-profile returns (AccountDisplayProfileResponse)

    @handler updateAccountDisplayProfile
    put /auth/me/display-profile (UpdateAccountDisplayProfileRequest) returns (AccountDisplayProfileResponse)
}

@server (
    prefix: /api/v1
    group: organizationdirectory
)
service app-api {
    @handler listDoctors
    get /directory/departments/:departmentId/doctors (DirectoryDoctorPathRequest) returns (ListDoctorsResponse)
}

@server (
    prefix: /api/v1
    group: identityadmin
    middleware: AccessToken
    authType: BearerAuth
)
service app-api {
    @handler listAdminAccounts
    get /admin/identity/accounts (ListAdminAccountsRequest) returns (ListAdminAccountsResponse)

    @handler getAdminAccount
    get /admin/identity/accounts/:accountId (AdminAccountPathRequest) returns (AdminAccountDetailResponse)

    @handler searchAdminAccountByPhone
    post /admin/identity/accounts/search-by-phone (AdminSearchAccountByPhoneRequest) returns (AdminSearchAccountByPhoneResponse)

    @handler promoteDoctor
    post /admin/identity/accounts/:accountId/promote-doctor (PromoteDoctorRequest) returns (AdminAccountDetailResponse)

    @handler updateDoctor
    put /admin/identity/doctors/:accountId (UpdateDoctorRequest) returns (AdminAccountDetailResponse)

    @handler changeDoctorDepartment
    put /admin/identity/doctors/:accountId/department (ChangeDoctorDepartmentRequest) returns (AdminAccountDetailResponse)

    @handler revokeDoctor
    post /admin/identity/doctors/:accountId/revoke (AccountMutationRequest) returns (AdminAccountDetailResponse)

    @handler disableAccount
    post /admin/identity/accounts/:accountId/disable (AccountMutationRequest) returns (AdminAccountDetailResponse)

    @handler enableAccount
    post /admin/identity/accounts/:accountId/enable (AccountMutationRequest) returns (AdminAccountDetailResponse)
}
