syntax = "v1"

import "identity-session.api"

type (
	SendPhoneLoginCodeRequest {
		Phone string `json:"phone"`
	}

	SendPhoneLoginCodeResponse {
		Accepted          bool  `json:"accepted"`
		RetryAfterSeconds int64 `json:"retry_after_seconds"`
	}

	PhoneLoginRequest {
		Phone            string `json:"phone"`
		VerificationCode string `json:"verification_code"`
	}

	WeChatLoginRequest {
		LoginCode string `json:"login_code"`
	}

	CurrentIdentityResponse {
		AccountID            string   `json:"account_id"`
		AccountType          string   `json:"account_type"`
		Status               string   `json:"status"`
		Roles                []string `json:"roles"`
		DepartmentID         string   `json:"department_id,optional"`
		Permissions          []string `json:"permissions"`
		AuthorizationVersion int64    `json:"authorization_version"`
	}

	SetPhoneRequest {
		Phone string `json:"phone"`
	}

	PhoneBindingResponse {
		PhoneMasked       string `json:"phone_masked"`
		VerificationStatus string `json:"verification_status"`
		VerificationSource string `json:"verification_source"`
	}

	SearchAccountByPhoneRequest {
		Phone string `json:"phone"`
	}

	SearchAccountByPhoneResponse {
		Identity CurrentIdentityResponse `json:"identity"`
		Phone    PhoneBindingResponse    `json:"phone"`
	}

	PromoteDoctorRequest {
		AccountID       string `json:"account_id"`
		DepartmentID    string `json:"department_id"`
		OfflineVerified bool   `json:"offline_verified"`
		OperationID     string `json:"operation_id"`
	}
)

@server (
	prefix: /api/v1
	group:  auth
)
service app-api {
	@handler sendPhoneLoginCode
	post /auth/phone/code (SendPhoneLoginCodeRequest) returns (SendPhoneLoginCodeResponse)

	@handler phoneLogin
	post /auth/phone/login (PhoneLoginRequest) returns (TokenResponse)

	@handler weChatLogin
	post /auth/wechat/login (WeChatLoginRequest) returns (TokenResponse)
}

@server (
	prefix:     /api/v1
	group:      auth
	middleware: AccessToken
)
service app-api {
	@handler currentIdentity
	get /auth/me returns (CurrentIdentityResponse)

	@handler setMyPhone
	put /auth/me/phone (SetPhoneRequest) returns (PhoneBindingResponse)
}

@server (
	prefix:     /api/v1
	group:      identityadmin
	middleware: AccessToken
)
service app-api {
	@handler searchAccountByPhone
	post /admin/identity/accounts/search-by-phone (SearchAccountByPhoneRequest) returns (SearchAccountByPhoneResponse)

	@handler promoteDoctor
	post /admin/identity/doctors/promote (PromoteDoctorRequest) returns (CurrentIdentityResponse)
}
