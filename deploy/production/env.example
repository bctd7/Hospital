# Copy this file to .env.production on the server. Never commit the real file.
APP_PORT=8888
APP_BIND_ADDRESS=0.0.0.0

MYSQL_DATABASE=hospital
MYSQL_USER=hospital
MYSQL_PASSWORD=replace_with_random_alphanumeric_value
MYSQL_ROOT_PASSWORD=replace_with_random_alphanumeric_value
IDENTITY_MYSQL_USER=hospital_identity
IDENTITY_MYSQL_PASSWORD=replace_with_random_alphanumeric_value
IDENTITY_MYSQL_DSN=hospital_identity:replace_with_same_identity_password@tcp(mysql:3306)/hospital_identity?parseTime=true&charset=utf8mb4&loc=UTC
APPOINTMENT_MYSQL_USER=hospital_appointment
APPOINTMENT_MYSQL_PASSWORD=replace_with_random_alphanumeric_value
APPOINTMENT_MYSQL_DSN=hospital_appointment:replace_with_same_appointment_password@tcp(mysql:3306)/hospital_appointment?parseTime=true&charset=utf8mb4&loc=UTC
GUIDANCE_MYSQL_USER=hospital_guidance
GUIDANCE_MYSQL_PASSWORD=replace_with_random_alphanumeric_value
GUIDANCE_MYSQL_DSN=hospital_guidance:replace_with_same_guidance_password@tcp(mysql:3306)/hospital_guidance?parseTime=true&charset=utf8mb4&loc=UTC
AMAP_WEB_SERVICE_KEY=replace_with_amap_web_service_key
GUIDANCE_LLM_ENDPOINT=
GUIDANCE_LLM_API_KEY=
GUIDANCE_LLM_MODEL=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_random_alphanumeric_value

IDENTITY_KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:29092

IDENTITY_ACCESS_PRIVATE_KEY_BASE64=replace_with_production_private_signing_key
IDENTITY_ACCESS_PUBLIC_KEY_BASE64=replace_with_production_public_signing_key
IDENTITY_PHONE_LOOKUP_KEY_BASE64=replace_with_32_random_bytes_in_base64
IDENTITY_BOOTSTRAP_HOSPITAL_CODE=HOSPITAL
IDENTITY_BOOTSTRAP_HOSPITAL_NAME=replace_with_experience_hospital_name
# Comma-separated mainland mobile numbers. Replace both values before deployment.
# Keep real values only in .env.production.
IDENTITY_BOOTSTRAP_ADMIN_PHONES=replace_with_first_admin_phone,replace_with_second_admin_phone
# 体验数据中的第三位真实账号。该账号只授予科室医生角色，不授予超级管理员。
EXPERIENCE_REAL_DOCTOR_PHONE=replace_with_real_doctor_phone


ALIBABA_CLOUD_ACCESS_KEY_ID=replace_with_ram_user_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace_with_ram_user_access_key_secret
SMS_PROVIDER=aliyun
ALIYUN_PNVS_SIGN_NAME=replace_with_approved_sign_name
ALIYUN_PNVS_TEMPLATE_CODE=replace_with_approved_template_code
ALIYUN_PNVS_SCHEME_NAME=
